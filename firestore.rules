rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny all access by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidLineItem(item) {
      return item is map &&
             item.keys().hasAll(['productId', 'productName', 'unitPrice', 'quantity', 'lineTotal']) &&
             item.keys().hasOnly(['productId', 'productName', 'unitPrice', 'quantity', 'lineTotal']) &&
             item.productId is string && item.productId.size() >= 1 && item.productId.size() <= 128 &&
             item.productName is string && item.productName.size() >= 1 && item.productName.size() <= 60 &&
             item.unitPrice is number && item.unitPrice >= 0 && item.unitPrice <= 100000 &&
             item.quantity is int && item.quantity >= 1 && item.quantity <= 200 &&
             item.lineTotal is number && item.lineTotal >= 0 && item.lineTotal <= 1000000;
    }

    function isValidStaff(data) {
      return data.username is string && data.username.size() >= 2 && data.username.size() <= 40 &&
             data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 60 &&
             data.role in ['ADMIN', 'WAITER'] &&
             data.passwordHash is string && data.passwordHash.size() >= 20 && data.passwordHash.size() <= 128 &&
             data.passwordSalt is string && data.passwordSalt.size() >= 12 && data.passwordSalt.size() <= 64 &&
             data.active is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidProduct(data) {
      return data.name is string && data.name.size() >= 1 && data.name.size() <= 60 &&
             data.category is string && data.category.size() >= 1 && data.category.size() <= 40 &&
             data.price is number && data.price >= 0 && data.price <= 100000 &&
             data.available is bool &&
             data.sortOrder is int && data.sortOrder >= 0 && data.sortOrder <= 10000 &&
             data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 40 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidTable(data) {
      return data.tableNumber is int && data.tableNumber >= 1 && data.tableNumber <= 20 &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 40 &&
             data.occupied is bool &&
             data.waiterName is string && data.waiterName.size() <= 40 &&
             data.customerNote is string && data.customerNote.size() <= 200 &&
             data.items is list && data.items.size() <= 50 &&
             (data.items.size() == 0 || isValidLineItem(data.items[0])) &&
             data.totalAmount is number && data.totalAmount >= 0 && data.totalAmount <= 1000000 &&
             data.openedAtMillis is int && data.openedAtMillis >= 0 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidOrder(data) {
      return data.tableNumber is int && data.tableNumber >= 1 && data.tableNumber <= 20 &&
             data.tableName is string && data.tableName.size() >= 1 && data.tableName.size() <= 40 &&
             data.waiterUsername is string && data.waiterUsername.size() >= 1 && data.waiterUsername.size() <= 40 &&
             data.closedByUsername is string && data.closedByUsername.size() >= 1 && data.closedByUsername.size() <= 40 &&
             data.paymentMethod in ['NAKİT', 'KART', 'HAVALE'] &&
             data.totalAmount is number && data.totalAmount > 0 && data.totalAmount <= 1000000 &&
             data.itemCount is int && data.itemCount >= 1 && data.itemCount <= 500 &&
             data.itemsSummary is string && data.itemsSummary.size() >= 1 && data.itemsSummary.size() <= 500 &&
             data.items is list && data.items.size() >= 1 && data.items.size() <= 50 &&
             isValidLineItem(data.items[0]) &&
             data.businessDate is string && data.businessDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             data.closedAtMillis is int && data.closedAtMillis > 0 &&
             data.status == 'COMPLETED' &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /users/{userId} {
      allow get, list: if isOwner(userId);
      allow create, update, delete: if false;

      match /staff/{staffId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId) && isValidId(staffId);
        allow create: if isOwner(userId) &&
                         isValidId(staffId) &&
                         incoming().keys().hasAll(['username', 'displayName', 'role', 'passwordHash', 'passwordSalt', 'active', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['username', 'displayName', 'role', 'passwordHash', 'passwordSalt', 'active', 'createdAt', 'updatedAt']) &&
                         isValidStaff(incoming());
        allow update: if isOwner(userId) &&
                         isValidId(staffId) &&
                         isValidStaff(incoming()) &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().username == existing().username &&
                         incoming().role == existing().role &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['passwordHash', 'passwordSalt', 'displayName', 'active', 'updatedAt']);
        allow delete: if false;
      }

      match /products/{productId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId) && isValidId(productId);
        allow create: if isOwner(userId) &&
                         isValidId(productId) &&
                         incoming().keys().hasAll(['name', 'category', 'price', 'available', 'sortOrder', 'updatedBy', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['name', 'category', 'price', 'available', 'sortOrder', 'updatedBy', 'createdAt', 'updatedAt']) &&
                         isValidProduct(incoming());
        allow update: if isOwner(userId) &&
                         isValidId(productId) &&
                         isValidProduct(incoming()) &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['name', 'category', 'price', 'available', 'sortOrder', 'updatedBy', 'updatedAt']);
        allow delete: if isOwner(userId) && isValidId(productId);
      }

      match /tables/{tableId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId) && isValidId(tableId);
        allow create: if isOwner(userId) &&
                         isValidId(tableId) &&
                         incoming().keys().hasAll(['tableNumber', 'name', 'occupied', 'waiterName', 'customerNote', 'items', 'totalAmount', 'openedAtMillis', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['tableNumber', 'name', 'occupied', 'waiterName', 'customerNote', 'items', 'totalAmount', 'openedAtMillis', 'createdAt', 'updatedAt']) &&
                         isValidTable(incoming());
        allow update: if isOwner(userId) &&
                         isValidId(tableId) &&
                         isValidTable(incoming()) &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().tableNumber == existing().tableNumber &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['name', 'occupied', 'waiterName', 'customerNote', 'items', 'totalAmount', 'openedAtMillis', 'updatedAt']);
        allow delete: if false;
      }

      match /orders/{orderId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId) && isValidId(orderId);
        allow create: if isOwner(userId) &&
                         isValidId(orderId) &&
                         incoming().keys().hasAll(['tableNumber', 'tableName', 'waiterUsername', 'closedByUsername', 'paymentMethod', 'totalAmount', 'itemCount', 'itemsSummary', 'items', 'businessDate', 'closedAtMillis', 'status', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['tableNumber', 'tableName', 'waiterUsername', 'closedByUsername', 'paymentMethod', 'totalAmount', 'itemCount', 'itemsSummary', 'items', 'businessDate', 'closedAtMillis', 'status', 'createdAt', 'updatedAt']) &&
                         isValidOrder(incoming());
        allow update: if false;
        allow delete: if false;
      }
    }
  }
}
